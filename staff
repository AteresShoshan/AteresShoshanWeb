<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Our Staff — Ateres Shoshana</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;0,900;1,400;1,600;1,700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap" rel="stylesheet">
<style>

:root {
  --concord: #482653;
  --concord-rgb: 72,38,83;
  --concord-dark: #371c40;
  --lavender: #b9add9;
  --lavender-tint: #e8e3f3;
  --lavender-ghost: #f4f1fa;
  --powder: #c7e0ff;
  --ivory: #ffffff;
  --cream: #f2eec5;
  --azure: #316ba9;
  --txt: #3d2548;
  --txt-mid: #64507a;
  --txt-soft: #8d7ea0;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  font-family:'DM Sans',system-ui,sans-serif;
  color:var(--txt-mid);
  background:var(--ivory);
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
}
img{max-width:100%;display:block}
a{text-decoration:none;color:inherit}

/* ══ NAV ══ */
.nav{
  position:fixed;top:0;left:0;right:0;z-index:999;
  background:rgba(255,255,255,0.88);
  backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
  border-bottom:1px solid rgba(var(--concord-rgb),0.06);
  transition:box-shadow .35s;
}
.nav.shadow{box-shadow:0 4px 30px rgba(var(--concord-rgb),0.06)}
.nav-in{
  max-width:1180px;margin:0 auto;padding:14px 36px;
  display:flex;align-items:center;justify-content:space-between;
}
.nav-brand{display:flex;align-items:center;gap:14px}
.nav-mark{
  width:44px;height:44px;background:var(--concord);border-radius:12px;
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 2px 8px rgba(var(--concord-rgb),0.25);
}
.nav-mark svg{width:28px;height:28px}
.nav-name{
  font-family:'Playfair Display',serif;font-weight:700;font-size:17px;
  color:var(--concord);line-height:1.15;
}
.nav-sub{
  font-size:9.5px;font-weight:500;letter-spacing:2.2px;text-transform:uppercase;
  color:var(--txt-soft);margin-top:1px;
}
.nav-links{display:flex;align-items:center;gap:32px}
.nav-links a{
  font-size:13px;font-weight:500;color:var(--txt-mid);
  position:relative;transition:color .2s;
}
.nav-links a::after{
  content:'';position:absolute;bottom:-3px;left:0;width:0;height:1.5px;
  background:var(--concord);transition:width .25s;
}
.nav-links a:hover{color:var(--concord)}
.nav-links a:hover::after{width:100%}
.nav-cta{
  background:var(--concord)!important;color:#fff!important;
  padding:11px 26px!important;border-radius:8px!important;
  font-weight:600!important;font-size:13px!important;
  box-shadow:0 2px 12px rgba(var(--concord-rgb),0.2);
  transition:all .25s!important;
}
.nav-cta::after{display:none!important}
.nav-cta:hover{
  background:var(--concord-dark)!important;
  transform:translateY(-1px);
  box-shadow:0 6px 20px rgba(var(--concord-rgb),0.3);
}
.burger{display:none;background:none;border:none;cursor:pointer;padding:8px}
.burger span{display:block;width:20px;height:2px;background:var(--concord);margin:4px 0;border-radius:2px}

/* ══ HERO ══ */
.hero{
  min-height:100vh;display:flex;align-items:center;
  padding:130px 36px 80px;position:relative;overflow:hidden;
  background:
    radial-gradient(ellipse 80% 60% at 75% 20%, rgba(185,173,217,0.18) 0%, transparent 60%),
    radial-gradient(ellipse 60% 50% at 20% 80%, rgba(199,224,255,0.12) 0%, transparent 60%),
    linear-gradient(170deg, #fff 0%, var(--lavender-ghost) 40%, var(--lavender-tint) 100%);
}
.hero-in{
  max-width:1180px;margin:0 auto;width:100%;
  display:grid;grid-template-columns:1.1fr 0.9fr;gap:56px;align-items:center;
}
.hero-pill{
  display:inline-flex;align-items:center;gap:8px;
  background:rgba(var(--concord-rgb),0.06);
  border:1px solid rgba(var(--concord-rgb),0.1);
  padding:8px 20px;border-radius:100px;
  font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;
  color:var(--concord);margin-bottom:28px;
  animation:rise .7s ease both;
}
.hero-pill i{width:6px;height:6px;background:var(--concord);border-radius:50%;flex-shrink:0}
.hero h1{
  font-family:'Playfair Display',serif;font-weight:900;
  font-size:clamp(40px,5.2vw,64px);line-height:1.06;
  color:var(--concord);margin-bottom:24px;
  animation:rise .7s ease .08s both;
}
.hero h1 em{font-style:italic;font-weight:700;color:var(--azure)}
.hero-sub{
  font-family:'Cormorant Garamond',serif;font-weight:700;
  font-size:clamp(20px,2.2vw,26px);color:var(--concord);line-height:1.55;
  margin-bottom:28px;max-width:520px;
  animation:rise .7s ease .15s both;
}
.hero-body{
  font-size:15.5px;line-height:1.75;color:var(--txt-mid);
  max-width:500px;margin-bottom:40px;
  animation:rise .7s ease .22s both;
}
.hero-btns{display:flex;gap:14px;flex-wrap:wrap;animation:rise .7s ease .3s both}
.btn{
  display:inline-flex;align-items:center;gap:8px;
  padding:16px 34px;border-radius:10px;
  font-family:'DM Sans',sans-serif;font-size:15px;font-weight:600;
  cursor:pointer;border:none;transition:all .28s;
}
.btn-p{
  background:var(--concord);color:#fff;
  box-shadow:0 4px 20px rgba(var(--concord-rgb),0.22);
}
.btn-p:hover{background:var(--concord-dark);transform:translateY(-2px);box-shadow:0 8px 28px rgba(var(--concord-rgb),0.28)}
.btn-s{
  background:transparent;color:var(--concord);
  border:2px solid rgba(var(--concord-rgb),0.18);
}
.btn-s:hover{border-color:var(--concord);background:rgba(var(--concord-rgb),0.03)}
.btn svg{width:16px;height:16px;flex-shrink:0}

/* hero visual */
.hero-vis{position:relative;animation:rise .8s ease .2s both}
.hero-card{
  background:#fff;border-radius:28px;padding:44px 36px;
  box-shadow:0 24px 64px rgba(var(--concord-rgb),0.09),0 2px 4px rgba(var(--concord-rgb),0.04);
  position:relative;max-width:400px;margin:0 auto;
}
.hero-card::before{
  content:'';position:absolute;inset:-2px;border-radius:30px;
  background:linear-gradient(140deg,var(--lavender),var(--powder) 50%,var(--cream) 100%);
  z-index:-1;opacity:.45;
}
.hero-quote{
  font-family:'Cormorant Garamond',serif;font-size:19px;font-weight:500;
  font-style:italic;color:var(--concord);text-align:center;line-height:1.55;
  margin-bottom:28px;padding:0 8px;
}
.hero-quote::before{content:'\201C';font-size:28px;color:var(--lavender)}
.hero-quote::after{content:'\201D';font-size:28px;color:var(--lavender)}
.hv-row{
  display:flex;align-items:flex-start;gap:14px;
  padding:14px 16px;background:var(--lavender-ghost);border-radius:14px;
  margin-bottom:10px;transition:transform .2s;
}
.hv-row:last-child{margin-bottom:0}
.hv-row:hover{transform:translateX(4px)}
.hv-icon{
  width:38px;height:38px;border-radius:11px;background:var(--concord);
  display:flex;align-items:center;justify-content:center;flex-shrink:0;
}
.hv-icon svg{width:18px;height:18px}
.hv-label{font-weight:700;font-size:13.5px;color:var(--concord);margin-bottom:2px}
.hv-desc{font-size:12px;color:var(--txt-soft);line-height:1.4}

.float-badge{
  position:absolute;background:#fff;border-radius:16px;padding:12px 18px;
  box-shadow:0 8px 28px rgba(var(--concord-rgb),0.1);
  display:flex;align-items:center;gap:10px;
}
.float-badge.top{top:-14px;right:-18px;animation:bob 4.5s ease-in-out infinite}
.float-badge.bot{bottom:-14px;left:-18px;animation:bob 4.5s ease-in-out 1.2s infinite}
.fb-icon{
  width:34px;height:34px;border-radius:10px;background:var(--lavender-ghost);
  display:flex;align-items:center;justify-content:center;
}
.fb-icon svg{width:16px;height:16px}
.fb-text{font-size:11.5px;font-weight:700;color:var(--concord);line-height:1.25}
.fb-sub{font-size:9.5px;color:var(--txt-soft);font-weight:400}

/* ══ SECTIONS SHARED ══ */
section{padding:100px 36px}
.sec-in{max-width:1100px;margin:0 auto}
.sec-tag{
  font-size:10.5px;font-weight:700;letter-spacing:3px;text-transform:uppercase;
  color:var(--concord);margin-bottom:14px;
}
.sec-h{
  font-family:'Playfair Display',serif;font-weight:700;
  font-size:clamp(28px,3.5vw,42px);color:var(--concord);line-height:1.15;
  margin-bottom:14px;
}
.sec-sub{
  font-family:'Cormorant Garamond',serif;font-size:18px;font-weight:500;
  font-style:italic;color:var(--txt-soft);max-width:600px;line-height:1.55;
}

/* reveal */
.rv{opacity:0;transform:translateY(32px);transition:opacity .65s ease,transform .65s ease}
.rv.on{opacity:1;transform:none}

/* ══ MISSION ══ */
.mission{background:#fff}
.mission-grid{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start;margin-top:52px}
.mission-text p{font-size:15.5px;line-height:1.8;margin-bottom:20px;color:var(--txt-mid)}
.mission-text p:last-child strong{color:var(--concord);font-weight:600}
.pillars{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.pill-card{
  padding:28px 22px;border-radius:18px;background:var(--lavender-ghost);
  border:1px solid rgba(var(--concord-rgb),0.04);
  transition:all .3s;
}
.pill-card:hover{transform:translateY(-5px);box-shadow:0 14px 36px rgba(var(--concord-rgb),0.07)}
.pc-icon{
  width:44px;height:44px;border-radius:13px;background:var(--concord);
  display:flex;align-items:center;justify-content:center;margin-bottom:14px;
}
.pc-icon svg{width:20px;height:20px}
.pill-card h4{
  font-family:'Playfair Display',serif;font-weight:700;font-size:16px;
  color:var(--concord);margin-bottom:6px;
}
.pill-card p{font-size:12.5px;color:var(--txt-soft);line-height:1.55}

/* ══ APPROACH ══ */
.approach{
  background:linear-gradient(180deg,var(--lavender-ghost) 0%,#fff 100%);
}
.approach-row{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:52px}
.ap-card{
  background:#fff;border-radius:22px;padding:36px 26px;
  border:1px solid rgba(var(--concord-rgb),0.04);
  position:relative;overflow:hidden;transition:all .3s;
}
.ap-card::before{
  content:'';position:absolute;top:0;left:0;right:0;height:3px;
  background:linear-gradient(90deg,var(--concord),var(--lavender));
  transform:scaleX(0);transform-origin:left;transition:transform .35s;
}
.ap-card:hover::before{transform:scaleX(1)}
.ap-card:hover{transform:translateY(-5px);box-shadow:0 18px 44px rgba(var(--concord-rgb),0.07)}
.ap-num{
  font-family:'Playfair Display',serif;font-weight:900;font-size:44px;
  color:var(--lavender-tint);line-height:1;margin-bottom:18px;
}
.ap-card h4{
  font-family:'Playfair Display',serif;font-weight:700;font-size:17px;
  color:var(--concord);margin-bottom:10px;line-height:1.3;
}
.ap-card p{font-size:13.5px;line-height:1.65;color:var(--txt-soft)}

/* ══ BEYOND ══ */
.beyond{
  background:var(--concord);position:relative;overflow:hidden;
}
.beyond::before{
  content:'';position:absolute;inset:0;
  background:
    radial-gradient(ellipse 50% 50% at 20% 50%,rgba(185,173,217,0.12) 0%,transparent 60%),
    radial-gradient(ellipse 40% 40% at 80% 30%,rgba(199,224,255,0.08) 0%,transparent 60%);
  pointer-events:none;
}
.beyond .sec-tag{color:var(--lavender)}
.beyond .sec-h{color:#fff}
.beyond .sec-sub{color:var(--lavender)}
.beyond-grid{
  display:grid;grid-template-columns:repeat(3,1fr);gap:20px;
  margin-top:52px;position:relative;z-index:1;
}
.by-card{
  background:rgba(255,255,255,0.05);
  border:1px solid rgba(255,255,255,0.08);
  border-radius:22px;padding:36px 26px;text-align:center;
  backdrop-filter:blur(6px);transition:all .3s;
}
.by-card:hover{background:rgba(255,255,255,0.09);transform:translateY(-5px)}
.by-icon{
  width:54px;height:54px;border-radius:16px;
  background:rgba(185,173,217,0.15);
  display:flex;align-items:center;justify-content:center;
  margin:0 auto 16px;
}
.by-icon svg{width:24px;height:24px}
.by-card h4{
  font-family:'Playfair Display',serif;font-weight:700;font-size:16.5px;
  color:#fff;margin-bottom:8px;
}
.by-card p{font-size:12.5px;line-height:1.55;color:var(--lavender)}

/* ══ LEADERSHIP ══ */
.lead{background:#fff}
.lead-cards{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:52px}
.l-card{
  background:var(--lavender-ghost);border-radius:26px;padding:44px 38px;
  border:1px solid rgba(var(--concord-rgb),0.04);
  position:relative;overflow:hidden;
}
.l-card::after{
  content:'';position:absolute;top:-40px;right:-40px;
  width:140px;height:140px;border-radius:50%;
  background:radial-gradient(circle,rgba(var(--concord-rgb),0.04) 0%,transparent 70%);
}
.l-photo{
  width:100px;height:100px;border-radius:20px;
  background:var(--lavender-tint);margin-bottom:20px;
  display:flex;align-items:center;justify-content:center;
  border:2px solid rgba(var(--concord-rgb),0.08);
}
.l-photo svg{width:36px;height:36px;opacity:.3}
.l-role{
  font-size:10.5px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;
  color:var(--azure);margin-bottom:10px;
}
.l-card h3{
  font-family:'Playfair Display',serif;font-weight:700;font-size:24px;
  color:var(--concord);margin-bottom:4px;
}
.l-cred{
  font-family:'Cormorant Garamond',serif;font-size:15px;font-style:italic;
  color:var(--txt-soft);margin-bottom:18px;
}
.l-card>p{font-size:14px;line-height:1.75;color:var(--txt-mid)}

/* ══ LEGACY ══ */
.legacy{
  background:linear-gradient(180deg,#fff 0%,var(--lavender-ghost) 100%);
}
.legacy-box{
  background:#fff;border-radius:28px;padding:56px;margin-top:48px;
  box-shadow:0 12px 48px rgba(var(--concord-rgb),0.05);
  border:1px solid rgba(var(--concord-rgb),0.04);
  display:grid;grid-template-columns:auto 1fr;gap:56px;align-items:center;
}
.leg-stat{text-align:center;min-width:180px}
.leg-stat-n{
  font-family:'Playfair Display',serif;font-weight:900;font-size:64px;
  color:var(--concord);line-height:1;
}
.leg-stat-l{font-size:14px;color:var(--txt-soft);margin-top:8px;line-height:1.45}
.leg-txt h3{
  font-family:'Playfair Display',serif;font-weight:700;font-size:26px;
  color:var(--concord);margin-bottom:14px;line-height:1.25;
}
.leg-txt p{font-size:15px;line-height:1.75;color:var(--txt-mid);margin-bottom:20px}
.leg-people{display:flex;gap:36px}
.leg-person strong{display:block;font-size:13.5px;color:var(--concord);font-weight:700}
.leg-person span{font-size:12px;color:var(--txt-soft)}

/* ══ RABBINICAL ══ */
.rabbinical{
  background:var(--lavender-ghost);text-align:center;padding:56px 36px;
}
.rab-h{
  font-family:'Playfair Display',serif;font-weight:700;font-size:22px;
  color:var(--concord);margin-bottom:14px;
}
.rab-names{
  font-size:16px;font-weight:600;color:var(--concord);margin-bottom:10px;
}
.rab-tag{
  font-family:'Cormorant Garamond',serif;font-size:15px;font-style:italic;
  color:var(--txt-soft);
}

/* ══ COMMUNITIES ══ */
.comm{background:var(--lavender-ghost);text-align:center;padding-top:20px}
.comm-pills{
  display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:36px;
}
.c-pill{
  background:#fff;border:1px solid rgba(var(--concord-rgb),0.06);
  border-radius:100px;padding:14px 30px;
  font-size:15px;font-weight:500;color:var(--concord);
  display:flex;align-items:center;gap:10px;transition:all .28s;cursor:default;
}
.c-pill svg{width:15px;height:15px;flex-shrink:0;transition:all .28s}
.c-pill:hover{
  background:var(--concord);color:#fff;
  transform:translateY(-3px);box-shadow:0 8px 24px rgba(var(--concord-rgb),0.15);
}
.c-pill:hover svg path{fill:#fff}

/* ══ CTA ══ */
.cta{
  background:linear-gradient(140deg,var(--concord) 0%,var(--concord-dark) 100%);
  text-align:center;position:relative;overflow:hidden;
  padding:110px 36px;
}
.cta::before{
  content:'';position:absolute;inset:0;
  background:
    radial-gradient(ellipse 40% 40% at 30% 50%,rgba(185,173,217,0.12) 0%,transparent 60%),
    radial-gradient(ellipse 35% 35% at 70% 50%,rgba(199,224,255,0.08) 0%,transparent 60%);
  pointer-events:none;
}
.cta-in{max-width:680px;margin:0 auto;position:relative;z-index:1}
.cta h2{
  font-family:'Playfair Display',serif;font-weight:700;
  font-size:clamp(28px,4vw,44px);color:#fff;margin-bottom:16px;line-height:1.15;
}
.cta-sub{
  font-family:'Cormorant Garamond',serif;font-size:20px;font-style:italic;
  color:var(--lavender);margin-bottom:44px;line-height:1.55;
}
.cta-btns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
.btn-w{
  background:#fff;color:var(--concord);
  box-shadow:0 4px 16px rgba(0,0,0,0.08);
}
.btn-w:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,0.12)}
.btn-o{
  background:transparent;color:#fff;
  border:2px solid rgba(255,255,255,0.25);
}
.btn-o:hover{border-color:#fff;background:rgba(255,255,255,0.06)}
.cta-info{
  margin-top:44px;display:flex;justify-content:center;gap:40px;flex-wrap:wrap;
}
.cta-info-item{
  display:flex;align-items:center;gap:8px;
  font-size:13.5px;color:var(--lavender);
}
.cta-info-item svg{width:15px;height:15px;opacity:.6;flex-shrink:0}

/* ══ FOOTER ══ */
footer{background:var(--concord-dark);padding:48px 36px 28px;text-align:center}
.ft-in{max-width:700px;margin:0 auto}
.ft-logo{margin-bottom:14px}
.ft-name{
  font-family:'Playfair Display',serif;font-weight:700;font-size:18px;
  color:#fff;margin-bottom:4px;
}
.ft-ptach{
  font-size:10px;font-weight:600;letter-spacing:2.5px;text-transform:uppercase;
  color:var(--lavender);margin-bottom:24px;opacity:.7;
}
.ft-links{display:flex;justify-content:center;gap:24px;margin-bottom:24px;flex-wrap:wrap}
.ft-links a{font-size:12.5px;color:var(--lavender);opacity:.6;transition:opacity .2s}
.ft-links a:hover{opacity:1;color:#fff}
.ft-line{width:50px;height:1px;background:rgba(185,173,217,0.15);margin:20px auto}
.ft-copy{font-size:10.5px;color:rgba(185,173,217,0.35)}

/* ══ ANIMATIONS ══ */
@keyframes rise{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:none}}
@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}

/* ══ RESPONSIVE ══ */
@media(max-width:1024px){
  .hero-in{grid-template-columns:1fr;text-align:center}
  .hero-sub,.hero-body{margin-left:auto;margin-right:auto}
  .hero-btns{justify-content:center}
  .hero-vis{order:1}
  .hero-card{max-width:380px}
  .float-badge.top{right:0}.float-badge.bot{left:0}
  .mission-grid{grid-template-columns:1fr;gap:40px}
  .approach-row{grid-template-columns:1fr 1fr}
  .legacy-box{grid-template-columns:1fr;padding:40px 32px;text-align:center}
  .leg-people{justify-content:center}
}
@media(max-width:768px){
  section{padding:72px 20px}
  .nav-links{display:none}
  .burger{display:block}
  .hero{padding:100px 20px 56px}
  .pillars{grid-template-columns:1fr}
  .approach-row{grid-template-columns:1fr}
  .beyond-grid{grid-template-columns:1fr}
  .lead-cards{grid-template-columns:1fr}
