/* ══ DROPDOWN NAV ══ */
.nav-dropdown{position:relative}
.nav-dropdown>a{cursor:pointer}
.nav-dropdown>a span.dd-arrow{display:inline-block;width:0;height:0;border-left:4px solid transparent;border-right:4px solid transparent;border-top:5px solid currentColor;margin-left:6px;vertical-align:middle}
.nav-dd{display:none;position:absolute;top:100%;left:50%;transform:translateX(-50%);background:#fff;border-radius:12px;box-shadow:0 8px 32px rgba(var(--concord-rgb),0.12);padding:8px 0;min-width:180px;z-index:1000;margin-top:12px}
.nav-dd::before{content:'';position:absolute;top:-6px;left:50%;transform:translateX(-50%);border-left:6px solid transparent;border-right:6px solid transparent;border-bottom:6px solid #fff}
.nav-dd a{display:block;padding:10px 20px;font-size:13px;font-weight:500;color:var(--txt-mid);white-space:nowrap;transition:all .2s}
.nav-dd a:hover{background:var(--lavender-ghost);color:var(--concord)}
.nav-dd a::after{display:none!important}
.nav-dropdown:hover .nav-dd{display:block}

